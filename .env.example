# Copy this file to .env and supply the calendar URLs locally.
# Never commit .env or share the signed Profixio URL.
SPORTADMIN_CALENDAR_URL=webcal://portalweb.sportadmin.se/webcal?id=YOUR_CALENDAR_ID
PROFIXIO_CALENDAR_URL=
# A safety floor. Lower only deliberately, for example during an off-season.
MIN_PROFIXIO_MATCHES=5
